#include <stdio.h>
#include <string.h>

int main() {
    int n, i;
    int largest;

    // PART 1: Finding the Largest Element in an Array

    printf("Enter number of elements in the array: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter %d elements: \n", n);

    for (i = 1; i < n; i++){
        if (arr[i] > largest){
            largest = arr[i];
        }
    }

    printf("The largest element in the array is: %d\n\n", largest);

    // PART 2: Counting the Number of Vowels in a String

    char str[100];
    int vowels = 0;

    // Clear the leftover newline from scanf
    getchar();

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    for (i = 0; str[i] != '\0'; i++){
        if (str[i] == 'a' || str[i] == 'e' || str[i] == 'i' ||
            str[i] == 'o' || str[i] == 'u' || 
            str[i] == 'A' || str[i] == 'E' || str[i] == 'i' ||
            str[i] == 'O' || str[i] == 'U') {

            vowels++;
            } 
    }

    printf("The number of vowels in the string is: %d\n", vowels);
    

    return 0;
}
